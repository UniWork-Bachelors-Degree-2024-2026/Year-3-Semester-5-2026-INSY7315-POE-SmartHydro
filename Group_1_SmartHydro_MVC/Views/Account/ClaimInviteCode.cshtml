@model Group_1_SmartHydro_MVC.Models.ClaimInviteCodeViewModel
@{
    Layout = null;
    ViewData["Title"] = "Join Your Team";

    string? formError = null;
    if (ViewData.ModelState.TryGetValue(string.Empty, out var formState))
    {
        formError = formState.Errors.Select(e => e.ErrorMessage).FirstOrDefault();
    }
}
<!DOCTYPE html>
<html lang="en" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Smart Hydro</title>
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <script src="~/js/busy-submit.js" asp-append-version="true" defer></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0..1,0" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reader.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/auth-modals.css" asp-append-version="true" />
</head>
<body class="sh-auth-body">
    <main class="sh-auth-main">
        <div class="sh-auth-center">
            <div class="sh-auth-center-stack">
                <div class="sh-card sh-auth-card sh-auth-card--invite">
                    <button class="sh-theme-toggle sh-contrast-toggle sh-auth-theme-toggle sh-auth-contrast-toggle" type="button" id="sh-contrast-toggle" aria-pressed="false" aria-label="Turn on high contrast" title="Turn on high contrast">
                        <span class="material-symbols-outlined" aria-hidden="true">contrast</span>
                    </button>
                    <button class="sh-theme-toggle sh-auth-theme-toggle" type="button" id="sh-theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
                        <span class="material-symbols-outlined sh-theme-icon sh-theme-icon-light" aria-hidden="true">light_mode</span>
                        <span class="material-symbols-outlined sh-theme-icon sh-theme-icon-dark" aria-hidden="true">dark_mode</span>
                    </button>
                    <partial name="_AuthReaderButtons" />

                    <div class="sh-auth-header sh-auth-header--invite">
                        <div class="sh-auth-icon-col">
                            <span class="sh-auth-brand-icon">
                                <img src="~/images/logo.png" alt="Smart Hydro logo" />
                            </span>
                            <span class="sh-auth-brand-name">Smart Hydro</span>
                        </div>
                        <div class="sh-auth-heading-col">
                            <h1 class="sh-auth-heading">Join Your Team</h1>
                            <p class="sh-auth-subtext">Enter the email and access code from your invitation, then choose a password.</p>
                        </div>
                    </div>

                    <form class="sh-auth-form sh-auth-form--invite" asp-controller="Account" asp-action="ClaimInviteCode" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        @if (formError != null)
                        {
                            <div class="sh-auth-alert" id="sh-auth-alert" role="alert">
                                <span class="material-symbols-outlined sh-auth-alert-icon" aria-hidden="true">error</span>
                                <span class="sh-auth-alert-text">@formError</span>
                                <button type="button" class="sh-auth-alert-close" id="sh-auth-alert-close" aria-label="Dismiss">
                                    <span class="material-symbols-outlined" aria-hidden="true">close</span>
                                </button>
                            </div>
                        }

                        <div class="sh-field">
                            <label class="sh-field-label" asp-for="Email">Email address</label>
                            <input asp-for="Email" class="sh-input" placeholder="you@smarthydro.com" autocomplete="username" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="sh-field">
                            <label class="sh-field-label" asp-for="Code">Access code</label>
                            <input asp-for="Code" class="sh-input" placeholder="e.g. HYDR-9X2W" style="text-transform:uppercase" autocomplete="off" />
                            <span asp-validation-for="Code" class="text-danger"></span>
                        </div>

                        <div class="sh-field">
                            <label class="sh-field-label" asp-for="FullName">Full name</label>
                            <input asp-for="FullName" class="sh-input" placeholder="Jane Doe" autocomplete="name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="sh-field">
                            <label class="sh-field-label" asp-for="Password">New password</label>
                            <div class="sh-auth-password-wrap">
                                <input asp-for="Password" type="password" class="sh-input" placeholder="At least 8 characters" autocomplete="new-password" />
                                <button type="button" class="sh-auth-toggle-visibility" id="sh-password-toggle" aria-label="Show password">
                                    <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="sh-field">
                            <label class="sh-field-label" asp-for="ConfirmPassword">Confirm password</label>
                            <div class="sh-auth-password-wrap">
                                <input asp-for="ConfirmPassword" type="password" class="sh-input" placeholder="Re-enter your password" autocomplete="new-password" />
                                <button type="button" class="sh-auth-toggle-visibility" id="sh-confirm-password-toggle" aria-label="Show password">
                                    <span class="material-symbols-outlined" aria-hidden="true">visibility</span>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="sh-submit-btn sh-auth-submit">Join Team</button>
                    </form>

                    <div class="sh-auth-divider">or</div>
                    <p class="sh-auth-footer-note"><a asp-controller="Account" asp-action="Login">Back to sign in</a></p>
                </div>
            </div>
        </div>

        <div class="sh-auth-page-foot">&copy; @DateTime.Now.Year Smart Hydro</div>
    </main>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/register.js" asp-append-version="true"></script>
    <script src="~/js/reader.js" asp-append-version="true"></script>
</body>
</html>
