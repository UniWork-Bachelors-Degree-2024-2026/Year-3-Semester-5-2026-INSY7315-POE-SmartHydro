<!DOCTYPE html>
<html lang="en" data-theme="light" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>@ViewData["Title"] - Smart Hydro Help Guide</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/theme.css" asp-append-version="true" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,400,0..1,0" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reader.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="sh-app">
        <partial name="_Sidebar" />
        <div class="sh-backdrop" id="sh-backdrop" aria-hidden="true"></div>

        <div class="sh-main">
            <header class="sh-topbar">
                <button class="sh-menu-btn" type="button" id="sh-menu-toggle" aria-label="Open menu" aria-controls="sh-sidebar" aria-expanded="false">
                    <span class="material-symbols-outlined" aria-hidden="true">menu</span>
                </button>
                <h1 class="sh-page-title">@ViewData["Title"]</h1>
                <button class="sh-theme-toggle sh-contrast-toggle" type="button" id="sh-contrast-toggle" aria-pressed="false" aria-label="Turn on high contrast" title="Turn on high contrast">
                    <span class="material-symbols-outlined" aria-hidden="true">contrast</span>
                </button>
                <button class="sh-theme-toggle" type="button" id="sh-theme-toggle" aria-label="Switch to dark mode" title="Switch to dark mode">
                    <span class="material-symbols-outlined sh-theme-icon sh-theme-icon-light" aria-hidden="true">light_mode</span>
                    <span class="material-symbols-outlined sh-theme-icon sh-theme-icon-dark" aria-hidden="true">dark_mode</span>
                </button>
                <button class="sh-theme-toggle sh-reader-btn sh-reader-toggle" type="button" id="sh-reader-toggle" aria-pressed="false" aria-label="Turn on read aloud" title="Turn on read aloud">
                    <span class="material-symbols-outlined" aria-hidden="true">record_voice_over</span>
                </button>
                <button class="sh-theme-toggle sh-reader-btn" type="button" id="sh-reader-read" aria-label="Read this page aloud" title="Read this page aloud" hidden>
                    <span class="material-symbols-outlined" aria-hidden="true">volume_up</span>
                </button>
            </header>

            <main class="sh-content" id="sh-main-content" tabindex="-1">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/reader.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
