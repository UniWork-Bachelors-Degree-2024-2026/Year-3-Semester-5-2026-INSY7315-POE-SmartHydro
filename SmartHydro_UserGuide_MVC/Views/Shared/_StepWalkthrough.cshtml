<div class="sh-walk-overlay" id="sh-walk" hidden role="dialog" aria-modal="true" aria-labelledby="sh-walk-title">
    <div class="sh-walk">
        <div class="sh-walk-top">
            <span class="sh-walk-count" id="sh-walk-count"></span>
            <button class="sh-theme-toggle sh-walk-close" type="button" id="sh-walk-close" aria-label="Close" title="Close">
                <span class="material-symbols-outlined" aria-hidden="true">close</span>
            </button>
        </div>
        <div class="sh-walk-bar"><i id="sh-walk-bar"></i></div>
        <div class="sh-walk-num" id="sh-walk-num"></div>
        <h3 class="sh-walk-title" id="sh-walk-title"></h3>
        <div class="sh-walk-text" id="sh-walk-text"></div>
        <div class="sh-walk-nav">
            <button class="sh-btn" type="button" id="sh-walk-back">
                <span class="material-symbols-outlined" aria-hidden="true">arrow_back</span>
                Back
            </button>
            <button class="sh-btn sh-btn-primary" type="button" id="sh-walk-next"></button>
        </div>
    </div>
</div>
